# Keep the public repository explicit: local inventories and old experiments stay local.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/boothlib/
!/build/
!/tests/
!/tools/
!/docs/
!/run.py
!/pyproject.toml
!/requirements-build.txt
!/README.md
!/CHANGELOG.md
!/PRIVACY.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/LICENSE
/build/*
!/build/booth_nest.spec
!/build/version_info.txt
/tests/*
!/tests/test_public_release.py
!/tests/test_functional_features.py
!/tests/test_matching.py
!/tests/test_schema.py
!/tests/test_sort_time.py
!/tests/test_ui_search.py
!/tests/_check_ui_syntax.py
!/tests/fixtures/
/tools/*
!/tools/build_release.py
!/tools/check_release.py
!/tools/make_installer.py
!/tools/test.py
__pycache__/
*.py[cod]
.venv/
*.egg-info/
*.log
*.tmp
config.json
dataset.json
probe_cache.json
manual_overrides.json

# Website source only; runtime datasets and captures remain outside Git.
!/web/
/web/data/
/web/public/media/
/web/reference/
/web/artifacts/
/web/release/
/web/dist/
/web/desktop-build/
/web/resources/*.sqlite*
/web/resources/*.db*
/web/resources/*.parquet
/web/resources/*.manifest.json
/web/.env
/web/node_modules/
