{
  "manifest_version": 3,
  "name": "BoothNest 已购同步",
  "version": "1.0.0",
  "description": "每天将已登录 BOOTH 下载库的商品清单同步到本机 BoothNest。",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://accounts.booth.pm/*", "https://booth.pm/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "BoothNest 已购同步", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://accounts.booth.pm/library*", "https://accounts.booth.pm/*/library*", "https://booth.pm/library*", "https://booth.pm/*/library*"],
    "js": ["content.js"], "run_at": "document_idle"
  }],
  "web_accessible_resources": [{ "resources": ["purchase-reader.js"], "matches": ["https://accounts.booth.pm/*", "https://booth.pm/*"] }]
}
